# ============================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# Never commit the .env file — it contains secrets
# ============================================================

# ------------------------------------------------------------
# AI Provider — choose one (or configure both)
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Which AI provider to use: "openai" or "anthropic"
AI_PROVIDER=openai

# Which model to use
# OpenAI options:    gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic options: claude-sonnet-4-5, claude-haiku-3-5
AI_MODEL=gpt-4o

# ------------------------------------------------------------
# Service Ports (change only if you have conflicts)
# ------------------------------------------------------------
GATEWAY_PORT=8000
CORRECTION_PORT=8001
STORAGE_PORT=8002
ANALYTICS_PORT=8003
DIAGNOSIS_PORT=8004
REDIS_PORT=6379

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------
# Storage Service
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./english_tutor.db
